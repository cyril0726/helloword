{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helloword-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helloword-db",
      "database_id": "c7c2ae3a-173f-4f81-bf19-02c5dedb9688"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "QUICKDRAW_ROOM",
        "class_name": "QuickdrawRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuickdrawRoom"]
    }
  ]
}
